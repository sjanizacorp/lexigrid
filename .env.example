# Generate separate long random secrets. Never commit real values.
POSTGRES_OWNER_PASSWORD=
RUNTIME_DB_PASSWORD=
JWT_SECRET=
AUDIT_HMAC_KEY=
EVIDENCE_ENCRYPTION_KEY=

# Enterprise integrations (configure in api service for deployment)
LEXIGRID_KMS_PROVIDER=local
LEXIGRID_CONJUR_URL=
LEXIGRID_CONJUR_ACCOUNT=
LEXIGRID_CONJUR_LOGIN=
LEXIGRID_CONJUR_API_KEY=
LEXIGRID_CONJUR_KEY_ID=lexigrid/evidence/v1
LEXIGRID_CONJUR_CA_BUNDLE=
LEXIGRID_ANCHOR_HMAC_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_48_PLUS_CHARACTER_SECRET
LEXIGRID_AUDIT_WORM_BUCKET=
LEXIGRID_AUDIT_RETENTION_DAYS=365
LEXIGRID_SAML_SP_ENTITY_ID=
LEXIGRID_SAML_ACS_URL=
LEXIGRID_SAML_IDP_ENTITY_ID=
LEXIGRID_SAML_IDP_SSO_URL=
LEXIGRID_SAML_IDP_CERT=
# Federated OIDC/SAML MFA policy; local login has its own override below.
LEXIGRID_REQUIRE_MFA=1
# Local password login may enroll an authenticator later in Account Security.
LEXIGRID_REQUIRE_LOCAL_MFA=0
# Trust only contexts that the configured IdP reserves for actual MFA.
LEXIGRID_SAML_MFA_CONTEXTS=https://refeds.org/profile/mfa,https://refeds.org/profile/mfa/phr
LEXIGRID_PUBLIC_HOST=
LEXIGRID_SAML_LABEL=Active Directory Federation Services
# AD FS MFA context identifier (only when the IdP asserts it after MFA):
# LEXIGRID_SAML_MFA_CONTEXTS=http://schemas.microsoft.com/claims/multipleauthn
# Entra ID OIDC may be enabled alongside AD FS SAML.
# Use the tenant-specific issuer, not /common or /organizations.
LEXIGRID_OIDC_ISSUER=
LEXIGRID_OIDC_CLIENT_ID=
LEXIGRID_OIDC_CLIENT_SECRET=
LEXIGRID_OIDC_REDIRECT_URI=
LEXIGRID_OIDC_LABEL=Microsoft Entra ID
# Optional Entra authentication context IDs whose policies REQUIRE MFA (e.g. c1).
# Leave empty unless the matching Conditional Access policy has been verified.
LEXIGRID_OIDC_MFA_ACRS=

# AI risk assessment: local-only by default; no cloud calls unless explicitly enabled.
LEXIGRID_AI_PROVIDER=ollama
LEXIGRID_AI_MODEL=qwen2.5:7b
LEXIGRID_AI_ENDPOINT=http://127.0.0.1:11434
LEXIGRID_AI_AIRGAPPED=1
LEXIGRID_AI_ALLOW_CLOUD=0
LEXIGRID_AI_LOCAL_HOSTS=127.0.0.1,localhost,::1
# Cloud providers only: configure via a secret manager or restricted env file.
LEXIGRID_AI_API_KEY=

# SMTP is shared by manual risk updates, automated risk emails and workflow notifications.
# Set these in the installed .env.native (native) or .env (Docker), then restart.
# Do not commit real credentials to source control. STARTTLS=587, SSL/TLS=465.
LEXIGRID_SMTP_HOST=
LEXIGRID_SMTP_PORT=587
LEXIGRID_SMTP_SECURITY=starttls
LEXIGRID_SMTP_FROM=
LEXIGRID_SMTP_USERNAME=
LEXIGRID_SMTP_PASSWORD=

# Enable the single-instance background worker for queued emails and reminders.
LEXIGRID_MAIL_WORKER=0
# When set to 1, reject invalid mail settings at application startup.
LEXIGRID_MAIL_STRICT_STARTUP=0
# Optional secret (at least 32 characters) for authenticated delivery/bounce webhooks.
LEXIGRID_MAIL_WEBHOOK_SECRET=
# Legacy workflow notifications; email uses the same SMTP credentials above.
LEXIGRID_NOTIFY_EMAIL_ENABLED=0

# v5.53: stable 32-byte base64url key for encrypted browser-managed SMTP settings. REQUIRED to save browser settings.
LEXIGRID_MAIL_CONFIG_KEY=
# Set 1 on each notification worker instance. PostgreSQL recommended for multi-host deployment.
LEXIGRID_MAIL_WORKER=0

# Independent acceptance expiry scan, every 60 seconds; separate from SMTP.
LEXIGRID_ACCEPTANCE_WORKER=1
